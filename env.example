# Admin login password (change in production)
# Use quotes if your password contains $ or special characters
ADMIN_PASSWORD="your-secure-password"

# Min 32 characters — used to encrypt the session cookie
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Required on Vercel (Storage → Blob → connect to this project). Auto-set as BLOB_READ_WRITE_TOKEN.
# BLOB_READ_WRITE_TOKEN=

# Contact form — sends to your inbox via https://resend.com
RESEND_API_KEY=re_xxxxxxxx
# Inbox for contact submissions (defaults to ryanoforikoree@gmail.com if unset)
CONTACT_TO_EMAIL=ryanoforikoree@gmail.com
# Until you verify a domain in Resend, use onboarding@resend.dev (to your Resend account email only)
# RESEND_FROM=Ryan Portfolio <onboarding@resend.dev>
# After domain verify, e.g. RESEND_FROM=Ryan Portfolio <hello@yourdomain.com>
